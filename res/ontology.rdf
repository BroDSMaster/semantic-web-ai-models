    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    <rdfs:label>pipeline task</rdfs:label>
    <rdfs:comment>Repository task metadata, such as text-generation; not an independently validated capability.</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:about="https://brodsmaster.github.io/semantic-web-ai-models/data/aimodels.ttl#literalValue">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:domain rdf:resource="https://brodsmaster.github.io/semantic-web-ai-models/data/aimodels.ttl#FactObservation"/>
    <rdfs:label>literal value</rdfs:label>
    <rdfs:comment>Observation to its literal-valued statement object.</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:about="https://brodsmaster.github.io/semantic-web-ai-models/data/aimodels.ttl#onBenchmark">
