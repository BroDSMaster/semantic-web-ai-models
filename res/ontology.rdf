    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#decimal"/>
    <rdfs:label>discount fraction</rdfs:label>
    <rdfs:comment>Source fraction; priceAmount includes rawAmount multiplied by (1 - discount). Negative source values represent a surcharge; values above 1 are invalid.</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:about="https://brodsmaster.github.io/semantic-web-ai-models/data/aimodels.ttl#relatedDocumentation">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:range rdf:resource="https://brodsmaster.github.io/semantic-web-ai-models/data/aimodels.ttl#SourceDocument"/>
    <rdfs:label>related documentation</rdfs:label>
    <rdfs:comment>Relevant developer documentation; relevance alone does not prove each field on a model.</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:about="https://brodsmaster.github.io/semantic-web-ai-models/data/aimodels.ttl#evaluator">
