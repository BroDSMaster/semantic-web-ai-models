    <rdfs:range rdf:resource="https://brodsmaster.github.io/semantic-web-ai-models/data/aimodels.ttl#AIModel"/>
    <rdfs:label>evaluated model</rdfs:label>
    <rdfs:comment>Result to the explicitly mapped model ID.</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:about="https://brodsmaster.github.io/semantic-web-ai-models/data/aimodels.ttl#pipelineTag">
