  </rdf:Description>
  <rdf:Description rdf:about="https://brodsmaster.github.io/semantic-web-ai-models/data/aimodels.ttl#Evaluation">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label>Evaluation</rdfs:label>
    <rdfs:comment>One model's reported result on a benchmark with a recorded scale, configuration and source.</rdfs:comment>
    <owl:disjointWith rdf:resource="https://brodsmaster.github.io/semantic-web-ai-models/data/aimodels.ttl#Benchmark"/>
  </rdf:Description>
