@prefix ex: <https://brodsmaster.github.io/semantic-web-ai-models/data/aimodels.ttl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix schema: <https://schema.org/> .
@prefix prov: <http://www.w3.org/ns/prov#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

# Synthetic teaching fixture, never loaded by the catalog loader.
ex:ExampleModel a ex:AIModel ; rdfs:label "Example Opus fixture" ;
    ex:sourceId "fixture/opus" ; ex:belongsToFamily ex:ExampleFamily ; ex:developedBy ex:ExampleOrg .
ex:ExampleFamily a ex:ModelFamily ; rdfs:label "Claude" .
ex:ExampleOrg a ex:Organization ; rdfs:label "Example provider" .
ex:ExampleOffering a ex:ModelOffering ; ex:offersModel ex:ExampleModel ;
    ex:hostedBy ex:ExampleOrg ; ex:offeringKind "fixture" ; ex:serviceMode "standard" ; ex:hasPrice ex:ExamplePrice .
ex:ExamplePrice a ex:PriceSpecification ; ex:priceCategory "prompt" ;
    ex:priceAmount "5"^^xsd:decimal ; ex:priceUnit "million_tokens" ; ex:currency "USD" ;
    ex:observedAt "2026-10-05T00:00:00Z"^^xsd:dateTime ; prov:wasDerivedFrom ex:ExampleSource .
ex:ExampleSource a ex:SourceDocument ; schema:url <https://example.org/fixture> .
