@prefix fuseki: <http://jena.apache.org/fuseki#> .
@prefix tdb2: <http://jena.apache.org/2016/tdb#> .
<#modelsService> a fuseki:Service ;
    fuseki:name "aimodels-models" ; fuseki:serviceQuery "sparql", "query" ;
    fuseki:serviceUpload "upload" ; fuseki:serviceReadWriteGraphStore "data" ;
    fuseki:dataset <#modelsDataset> .
<#modelsDataset> a tdb2:DatasetTDB2 ; tdb2:location "run/tdb2-models" .
