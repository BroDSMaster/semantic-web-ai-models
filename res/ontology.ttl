@prefix ex: <https://example.org/aimodels/> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix schema: <https://schema.org/> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix dcterms: <http://purl.org/dc/terms/> .

ex:ontology a owl:Ontology ;
    rdfs:label "AI Research Knowledge Graph ontology"@en ;
    dcterms:description "Bibliographic AI research metadata, contextual authorship and OpenAlex topic hierarchy. Designed using ONTOLOGY_ENGINEERING_SKILL.md."@en ;
    owl:versionInfo "1.0.0" ;
    rdfs:seeAlso <https://help.openalex.org/>, <https://schema.org/ScholarlyArticle>, <http://www.w3.org/2004/02/skos/core> .

# Ten domain classes. Person is a type; authorship is a contextual role.
ex:ResearchPaper a owl:Class ; rdfs:subClassOf schema:ScholarlyArticle ;
    rdfs:label "Research paper"@en ;
    rdfs:comment "An individual research article, conference paper, preprint or review in the selected OpenAlex sample. Paratext/proceedings collections, books, chapters and reports are excluded. Identity is the OpenAlex work ID."@en .
ex:Person a owl:Class ; rdfs:subClassOf schema:Person ;
    rdfs:label "Person"@en ;
    rdfs:comment "A human represented by an OpenAlex author ID; not a research role or an organization. Author disambiguation depends on OpenAlex."@en .
ex:ResearchInstitution a owl:Class ; rdfs:subClassOf schema:Organization ;
    rdfs:label "Research institution"@en ;
    rdfs:comment "An organization appearing in an authorship affiliation. Membership here is a role in the sample, not a claim of perpetual research activity."@en .
ex:PublicationSource a owl:Class ;
    rdfs:label "Publication source"@en ;
    rdfs:comment "An OpenAlex journal, repository, conference or other publication source. It is a venue, not its publisher or a single paper."@en .
ex:Publisher a owl:Class ; rdfs:subClassOf schema:Organization ;
    rdfs:label "Publisher"@en ;
    rdfs:comment "An OpenAlex publisher entity with a P identifier hosting a publication source. Publishing is an organizational role; may overlap ResearchInstitution."@en .
ex:ResearchTopic a owl:Class ; rdfs:subClassOf skos:Concept ;
    rdfs:label "Research topic"@en ;
    rdfs:comment "A specific OpenAlex classification concept, not a paper and not a subclass of its subfield."@en .
ex:ResearchSubfield a owl:Class ; rdfs:subClassOf skos:Concept ;
    rdfs:label "Research subfield"@en ; rdfs:comment "A subfield concept in the OpenAlex four-level classification."@en .
ex:ResearchField a owl:Class ; rdfs:subClassOf skos:Concept ;
    rdfs:label "Research field"@en ; rdfs:comment "A field concept grouping subfields in OpenAlex, e.g. Computer Science."@en .
ex:ResearchDomain a owl:Class ; rdfs:subClassOf skos:Concept ;
    rdfs:label "Research domain"@en ; rdfs:comment "A broad domain concept grouping fields in OpenAlex, e.g. Physical Sciences."@en .
ex:Authorship a owl:Class ; rdfs:subClassOf schema:Role ;
    rdfs:label "Authorship"@en ;
    rdfs:comment "An author's participation in a particular paper. Identity is (work ID, author ID); affiliations, position and corresponding status belong to this association."@en .

# Clear identity distinctions. Organizational roles may overlap; no blanket disjointness.
[] a owl:AllDisjointClasses ; owl:members (ex:ResearchPaper ex:Person ex:Authorship schema:Organization skos:Concept) .

ex:hasAuthorship a owl:ObjectProperty ; rdfs:domain ex:ResearchPaper ; rdfs:range ex:Authorship ;
    owl:inverseOf ex:authoredPaper ; rdfs:label "has authorship"@en ;
    rdfs:comment "Connects a paper to contextual participation records. Multiple authors are allowed."@en .
ex:authoredPaper a owl:ObjectProperty ; rdfs:domain ex:Authorship ; rdfs:range ex:ResearchPaper ;
    rdfs:label "authored paper"@en ; rdfs:comment "Inverse of hasAuthorship; inferred by OWL RL if not asserted."@en .
ex:authorPerson a owl:ObjectProperty ; rdfs:domain ex:Authorship ; rdfs:range ex:Person ;
    rdfs:label "author person"@en ; rdfs:comment "The human participant of an authorship record."@en .
ex:affiliatedInstitution a owl:ObjectProperty ; rdfs:domain ex:Authorship ; rdfs:range ex:ResearchInstitution ;
    rdfs:label "affiliated institution in this authorship"@en ;
    rdfs:comment "Affiliation reported for this paper; does not imply current employment or affiliation for all papers by the person."@en .
ex:publishedIn a owl:ObjectProperty ; rdfs:domain ex:ResearchPaper ; rdfs:range ex:PublicationSource ;
    rdfs:label "published in"@en ; rdfs:comment "Primary publication source reported by OpenAlex; missing source is allowed."@en .
ex:publishedBy a owl:ObjectProperty ; rdfs:domain ex:PublicationSource ; rdfs:range ex:Publisher ;
    rdfs:label "published by"@en ; rdfs:comment "Connects a source to an OpenAlex publisher; institution-hosted repositories are not forced into this relation."@en .
ex:hasTopic a owl:ObjectProperty ; rdfs:domain ex:ResearchPaper ; rdfs:range ex:ResearchTopic ;
    rdfs:label "has topic"@en ; rdfs:comment "OpenAlex predicted topic assignment; not a manually verified research scope."@en .
ex:primaryTopic a owl:ObjectProperty ; rdfs:subPropertyOf ex:hasTopic ;
    rdfs:domain ex:ResearchPaper ; rdfs:range ex:ResearchTopic ;
    rdfs:label "primary topic"@en ; rdfs:comment "Highest-ranked OpenAlex topic for the work."@en .
ex:inSubfield a owl:ObjectProperty ; rdfs:subPropertyOf skos:broader ;
    rdfs:domain ex:ResearchTopic ; rdfs:range ex:ResearchSubfield ;
    rdfs:label "in subfield"@en ; rdfs:comment "Topic-to-subfield classification, not subclass inheritance."@en .
ex:inField a owl:ObjectProperty ; rdfs:subPropertyOf skos:broader ;
    rdfs:domain ex:ResearchSubfield ; rdfs:range ex:ResearchField ;
    rdfs:label "in field"@en ; rdfs:comment "Subfield-to-field classification."@en .
ex:inDomain a owl:ObjectProperty ; rdfs:subPropertyOf skos:broader ;
    rdfs:domain ex:ResearchField ; rdfs:range ex:ResearchDomain ;
    rdfs:label "in domain"@en ; rdfs:comment "Field-to-domain classification."@en .

# Identity URLs are not given a paper/person class range: that would infer types
# onto identifier resources. sameAs links are exported separately with evidence.
ex:doi a owl:ObjectProperty ; rdfs:domain ex:ResearchPaper ;
    rdfs:label "DOI URI"@en ; rdfs:comment "DOI resolver URI for this bibliographic work; retained as an identifier link."@en .
ex:orcid a owl:ObjectProperty ; rdfs:domain ex:Person ;
    rdfs:label "ORCID URI"@en ; rdfs:comment "ORCID researcher identifier reported by OpenAlex, if available."@en .
ex:ror a owl:ObjectProperty ; rdfs:domain ex:ResearchInstitution ;
    rdfs:label "ROR URI"@en ; rdfs:comment "ROR organization identifier reported by OpenAlex, if available."@en .

ex:publicationYear a owl:DatatypeProperty ; rdfs:domain ex:ResearchPaper ; rdfs:range xsd:gYear ;
    rdfs:label "publication year"@en ; rdfs:comment "Publication year reported by OpenAlex."@en .
ex:citationCount a owl:DatatypeProperty ; rdfs:domain ex:ResearchPaper ; rdfs:range xsd:nonNegativeInteger ;
    rdfs:label "citation count"@en ; rdfs:comment "OpenAlex cited_by_count at snapshot time; not the number of reference triples and not a benchmark score."@en .
ex:isOpenAccess a owl:DatatypeProperty ; rdfs:domain ex:ResearchPaper ; rdfs:range xsd:boolean ;
    rdfs:label "is open access"@en ; rdfs:comment "OpenAlex open-access flag at collection time; does not license full text."@en .
ex:workType a owl:DatatypeProperty ; rdfs:domain ex:ResearchPaper ; rdfs:range xsd:string ;
    rdfs:label "work type"@en ; rdfs:comment "OpenAlex work-type string, e.g. article or preprint."@en .
ex:countryCode a owl:DatatypeProperty ; rdfs:domain ex:ResearchInstitution ; rdfs:range xsd:string ;
    rdfs:label "country code"@en ; rdfs:comment "Institution country code from OpenAlex; not the nationality of the authors."@en .
ex:institutionType a owl:DatatypeProperty ; rdfs:domain ex:ResearchInstitution ; rdfs:range xsd:string ;
    rdfs:label "institution type"@en ; rdfs:comment "OpenAlex institution category, such as education or company."@en .
ex:sourceType a owl:DatatypeProperty ; rdfs:domain ex:PublicationSource ; rdfs:range xsd:string ;
    rdfs:label "source type"@en ; rdfs:comment "OpenAlex publication source type, such as journal or repository."@en .
ex:issnL a owl:DatatypeProperty ; rdfs:domain ex:PublicationSource ; rdfs:range xsd:string ;
    rdfs:label "ISSN-L"@en ; rdfs:comment "Linking ISSN of a source, when available."@en .
ex:authorPosition a owl:DatatypeProperty ; rdfs:domain ex:Authorship ; rdfs:range xsd:string ;
    rdfs:label "author position"@en ; rdfs:comment "OpenAlex first/middle/last category; not an invented numeric author order."@en .
ex:isCorresponding a owl:DatatypeProperty ; rdfs:domain ex:Authorship ; rdfs:range xsd:boolean ;
    rdfs:label "is corresponding author"@en ; rdfs:comment "Corresponding status for this particular paper."@en .
ex:collectionSearch a owl:DatatypeProperty ; rdfs:range xsd:string ;
    rdfs:label "collection search"@en ; rdfs:comment "Search expression used to obtain a dataset snapshot."@en .

# Reuse dcterms:title, identifier, source, issued, references; schema:author;
# rdfs:label and skos:broader without replacing their established definitions.
# Domain/range infer types. CSV/graph validation implements completeness checks;
# no OWL minimum cardinality or functional property is imposed on partial data.
