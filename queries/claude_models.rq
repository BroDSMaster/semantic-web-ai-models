PREFIX ex: <https://brodsmaster.github.io/semantic-web-ai-models/data/aimodels.ttl#>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
SELECT ?model ?name ?modelId WHERE {
  ?model a ex:AIModel ; rdfs:label ?name ; ex:sourceId ?modelId ; ex:belongsToFamily ?family .
  ?family rdfs:label "Claude" .
} ORDER BY ?name
