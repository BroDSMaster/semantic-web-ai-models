PREFIX ex: <https://brodsmaster.github.io/semantic-web-ai-models/data/aimodels.ttl#>
PREFIX prov: <http://www.w3.org/ns/prov#>
PREFIX schema: <https://schema.org/>
# Aggregate observations rather than a quadratic pairwise join.
# Distinct description wording is not, by itself, a semantic contradiction.
SELECT ?entity ?property
       (COUNT(DISTINCT ?value) AS ?distinctValues)
       (GROUP_CONCAT(DISTINCT STR(?value); separator=" | ") AS ?values)
       (GROUP_CONCAT(DISTINCT STR(?source); separator=" | ") AS ?sources)
WHERE {
  ?entity a ex:AIModel .
  ?observation ex:aboutEntity ?entity ; ex:observedProperty ?property ;
               ex:literalValue ?value ; prov:wasDerivedFrom ?document .
  FILTER(?property IN (ex:contextLength, ex:maxOutputTokens, ex:knowledgeCutoff))
  ?document schema:url ?source .
}
GROUP BY ?entity ?property
HAVING(COUNT(DISTINCT ?value) > 1)
ORDER BY ?entity ?property
