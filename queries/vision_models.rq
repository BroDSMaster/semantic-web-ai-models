PREFIX ex: <https://brodsmaster.github.io/semantic-web-ai-models/data/aimodels.ttl#>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
SELECT DISTINCT ?modelId ?name WHERE {
  ?model a ex:AIModel ; ex:sourceId ?modelId ; rdfs:label ?name ; ex:inputModality ?modality .
  ?modality rdfs:label "image" .
} ORDER BY ?modelId
