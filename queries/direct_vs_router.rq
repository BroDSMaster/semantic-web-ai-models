PREFIX ex: <https://brodsmaster.github.io/semantic-web-ai-models/data/aimodels.ttl#>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
PREFIX prov: <http://www.w3.org/ns/prov#>
PREFIX schema: <https://schema.org/>
# Rows sorted together by model/category provide a comparison without a
# quadratic join of price records. Each row retains its own conditions/source.
SELECT ?modelId ?category ?kind ?provider ?usdPerMillionTokens ?conditions ?source WHERE {
  ?offering ex:offeringKind ?kind ; ex:serviceMode ?mode ;
            ex:offersModel ?model ; ex:hostedBy ?host ; ex:hasPrice ?price .
  ?host rdfs:label ?provider .
  ?model ex:sourceId ?modelId .
  ?price ex:priceCategory ?category ; ex:priceAmount ?usdPerMillionTokens ;
         ex:priceUnit ?unit ; ex:priceTier "base" ; prov:wasDerivedFrom ?doc .
  ?doc schema:url ?source .
  FILTER(?kind IN ("direct", "openrouter_catalog"))
  FILTER(?mode = "standard" && ?unit = "million_tokens")
  OPTIONAL { ?price ex:conditions ?conditions }
} ORDER BY ?modelId ?category ?kind
