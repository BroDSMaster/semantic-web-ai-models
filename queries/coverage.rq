PREFIX ex: <https://brodsmaster.github.io/semantic-web-ai-models/data/aimodels.ttl#>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
SELECT ?developer (COUNT(DISTINCT ?model) AS ?models) WHERE {
  ?model a ex:AIModel ; ex:developedBy ?org . ?org rdfs:label ?developer .
} GROUP BY ?developer ORDER BY DESC(?models)
