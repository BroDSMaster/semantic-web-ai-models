# Replace Q49108 or add VALUES obtained from silver/institutions.csv.
# Execute this on https://dbpedia.org/sparql, not the local dataset.
PREFIX owl: <http://www.w3.org/2002/07/owl#>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
SELECT ?entity ?wd ?name WHERE {
  VALUES ?wd { <http://www.wikidata.org/entity/Q49108> }
  ?entity owl:sameAs ?wd .
  OPTIONAL { ?entity rdfs:label ?name . FILTER(lang(?name) = "en") }
  FILTER(STRSTARTS(STR(?entity), "http://dbpedia.org/resource/"))
}
