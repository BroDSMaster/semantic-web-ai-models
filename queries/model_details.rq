PREFIX ex: <https://example.org/aimodels/>
PREFIX schema: <https://schema.org/>
PREFIX prov: <http://www.w3.org/ns/prov#>
SELECT ?entity ?property ?value ?source ?observedAt WHERE {
  ?model ex:sourceId "openai/gpt-5.6-sol" .
  # Zero-or-one path covers the model itself and its offerings without
  # materializing an unbound UNION over all observations in the graph.
  ?entity ex:offersModel? ?model .
  ?observation ex:aboutEntity ?entity ; ex:observedProperty ?property ;
               prov:wasDerivedFrom ?doc ; ex:observedAt ?observedAt .
  OPTIONAL { ?observation ex:literalValue ?literal }
  OPTIONAL { ?observation ex:resourceValue ?resource }
  BIND(COALESCE(?literal, ?resource) AS ?value)
  ?doc schema:url ?source .
} ORDER BY ?entity ?property ?source
