PREFIX ex: <https://brodsmaster.github.io/semantic-web-ai-models/data/aimodels.ttl#>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
PREFIX schema: <https://schema.org/>
PREFIX prov: <http://www.w3.org/ns/prov#>
SELECT ?modelId ?property ?value ?source WHERE {
  ?model ex:sourceId ?modelId .
  ?obs ex:aboutEntity ?model ; ex:observedProperty ?property ; ex:literalValue ?value ; prov:wasDerivedFrom ?doc .
  ?doc ex:sourceKind ?kind ; schema:url ?source .
  FILTER(?kind IN ("official", "model_card"))
} ORDER BY ?modelId ?property
