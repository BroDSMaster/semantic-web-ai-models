PREFIX ex: <https://example.org/aimodels/>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
PREFIX schema: <https://schema.org/>
PREFIX dcterms: <http://purl.org/dc/terms/>
SELECT ?modelId ?title ?author ?date ?summary ?url WHERE {
  ?review a ex:Review ; schema:itemReviewed ?model ; rdfs:label ?title ;
          dcterms:creator ?author ; schema:url ?url .
  ?model ex:sourceId ?modelId .
  OPTIONAL { ?review dcterms:issued ?date } OPTIONAL { ?review dcterms:abstract ?summary }
} ORDER BY DESC(?date) ?modelId
